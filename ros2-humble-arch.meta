# colcon settings shipped by ros2-humble-arch (PATCHES.md #17).
#
# colcon reads every *.meta file in ~/.colcon/metadata/ on every build. Link
# this file there once:
#   mkdir -p ~/.colcon/metadata
#   ln -sf /usr/share/ros2-humble-arch/ros2-humble-arch.meta ~/.colcon/metadata/
#
# mitsubishi_robot_hardware (Vanderbilt-Applied-Robotics-Lab/mitsubishi_ros2)
# uses boost::asio::io_service and resolver::query, which Boost 1.87 removed.
# Arch's Boost is newer than that; Ubuntu 22.04 has 1.74. These arguments make
# CMake use the Boost 1.86 headers this package installs, for that one package
# only. The two -U lines drop the location CMake saved in an earlier build, so
# a workspace that already failed builds without being cleaned first.
names:
  mitsubishi_robot_hardware:
    cmake-args:
      - -UBoost_INCLUDE_DIR
      - -UBoost_DIR
      - -DBoost_NO_BOOST_CMAKE=ON
      - -DBoost_NO_SYSTEM_PATHS=ON
      - -DBOOST_INCLUDEDIR=/opt/ros/humble/opt/boost_1_86/include

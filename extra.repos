# Repositories ros2-humble-arch builds on top of ros2.repos (the ROS 2 Humble
# release manifest). Each is pinned to the version Humble released for Ubuntu
# 22.04, the same version `apt install ros-humble-<name>` installs there.
# Versions come from humble/distribution.yaml in github.com/ros/rosdistro.
#
# The set is what the course needs: MoveIt 2 (move_group, planning interface,
# RViz MotionPlanning plugin, setup assistant, OMPL/CHOMP/Pilz planners, KDL
# kinematics), ros2_control and ros2_controllers, xacro, joint_state_publisher,
# and everything those depend on. ompl, fcl and libccd are system libraries on
# Ubuntu; they are built here so they use the same Eigen 3.4.0 as everything else.
#
# To add a repository: append an entry with its released version, then rebuild.
repositories:
  extra/ackermann_msgs:
    type: git
    url: https://github.com/ros-drivers/ackermann_msgs.git
    version: 2.0.2
  extra/angles:
    type: git
    url: https://github.com/ros/angles.git
    version: 1.15.0
  extra/backward_ros:
    type: git
    url: https://github.com/pal-robotics/backward_ros.git
    version: 1.0.8
  extra/control_msgs:
    type: git
    url: https://github.com/ros-controls/control_msgs.git
    version: 4.9.0
  extra/control_toolbox:
    type: git
    url: https://github.com/ros-controls/control_toolbox.git
    version: 3.7.1
  extra/cpp_polyfills:
    type: git
    url: https://github.com/PickNikRobotics/cpp_polyfills.git
    version: 1.3.2
  extra/eigen_stl_containers:
    type: git
    url: https://github.com/ros/eigen_stl_containers.git
    version: 1.1.0
  extra/fcl:
    type: git
    url: https://github.com/flexible-collision-library/fcl.git
    version: 0.7.0
  extra/filters:
    type: git
    url: https://github.com/ros/filters.git
    version: 2.2.2
  extra/generate_parameter_library:
    type: git
    url: https://github.com/PickNikRobotics/generate_parameter_library.git
    version: 0.7.7
  extra/geometric_shapes:
    type: git
    url: https://github.com/ros-planning/geometric_shapes.git
    version: 2.3.4
  extra/graph_msgs:
    type: git
    url: https://github.com/PickNikRobotics/graph_msgs.git
    version: 0.2.1
  extra/joint_state_publisher:
    type: git
    url: https://github.com/ros/joint_state_publisher.git
    version: 2.4.0
  extra/kinematics_interface:
    type: git
    url: https://github.com/ros-controls/kinematics_interface.git
    version: 0.4.2
  extra/launch_param_builder:
    type: git
    url: https://github.com/PickNikRobotics/launch_param_builder.git
    version: 0.1.1
  extra/libccd:
    type: git
    url: https://github.com/danfis/libccd.git
    version: v2.1
  extra/moveit:
    type: git
    url: https://github.com/ros-planning/moveit2.git
    version: 2.5.10
  extra/moveit_msgs:
    type: git
    url: https://github.com/ros-planning/moveit_msgs.git
    version: 2.2.3
  extra/moveit_visual_tools:
    type: git
    url: https://github.com/ros-planning/moveit_visual_tools.git
    version: 4.2.0
  extra/object_recognition_msgs:
    type: git
    url: https://github.com/wg-perception/object_recognition_msgs.git
    version: 2.0.0
  extra/octomap:
    type: git
    url: https://github.com/octomap/octomap.git
    version: v1.9.8
  extra/octomap_msgs:
    type: git
    url: https://github.com/octomap/octomap_msgs.git
    version: 2.0.1
  extra/ompl:
    type: git
    url: https://github.com/ompl/ompl.git
    version: 1.7.0
  extra/random_numbers:
    type: git
    url: https://github.com/ros-planning/random_numbers.git
    version: 2.0.5
  extra/realtime_tools:
    type: git
    url: https://github.com/ros-controls/realtime_tools.git
    version: 2.15.1
  extra/ros2_control:
    type: git
    url: https://github.com/ros-controls/ros2_control.git
    version: 2.54.3
  extra/ros2_controllers:
    type: git
    url: https://github.com/ros-controls/ros2_controllers.git
    version: 2.54.1
  extra/rsl:
    type: git
    url: https://github.com/PickNikRobotics/RSL.git
    version: 1.3.0
  extra/ruckig:
    type: git
    url: https://github.com/pantor/ruckig.git
    version: v0.9.2
  extra/rviz_visual_tools:
    type: git
    url: https://github.com/PickNikRobotics/rviz_visual_tools.git
    version: 4.2.0
  extra/srdfdom:
    type: git
